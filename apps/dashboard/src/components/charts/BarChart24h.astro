---
interface DataPoint {
  hits: number;
  bots: number;
}
interface Props {
  data: DataPoint[];
  w?: number;
  h?: number;
  id?: string;
}
const { data, w = 680, h = 220, id = 'barchart-' + Math.random().toString(36).slice(2, 7) } = Astro.props;

const pad = { l: 36, r: 12, t: 16, b: 26 };
const iw = w - pad.l - pad.r;
const ih = h - pad.t - pad.b;
const maxV = data.length > 0 ? Math.max(...data.map(d => d.hits), 1) * 1.15 : 1;
const bw = data.length > 0 ? (iw / data.length) * 0.68 : 10;
const gap = data.length > 0 ? (iw / data.length) * 0.32 : 4;

function fmt(n: number): string {
  if (n >= 1_000_000) return (n/1_000_000).toFixed(1).replace(/\.0$/, '') + 'M';
  if (n >= 10_000) return Math.round(n/1000) + 'K';
  if (n >= 1000) return (n/1000).toFixed(1).replace(/\.0$/, '') + 'K';
  return String(n);
}

const chartDataJson = JSON.stringify(data.map((d, i) => ({
  hour: `${String(i).padStart(2, '0')}:00`,
  hits: d.hits,
  bots: d.bots,
  botPct: d.hits > 0 ? ((d.bots / d.hits) * 100).toFixed(1) : '0'
})));
---
<div class="barchart-wrapper" id={id} style="position:relative;width:100%;user-select:none;">
  <svg width={w} height={h} viewBox={`0 0 ${w} ${h}`} style="display:block;width:100%;height:auto;overflow:visible;">
    {Array.from({ length: 4 }).map((_, i) => {
      const y = pad.t + (ih / 3) * i;
      const v = maxV * (1 - i / 3);
      return (
        <g>
          <line x1={pad.l} y1={y} x2={w - pad.r} y2={y} stroke="var(--border-2)" stroke-dasharray="3,3" />
          <text x={pad.l - 6} y={y + 4} text-anchor="end" fill="var(--text-3)" font-size="10" font-family="var(--mono)">
            {fmt(v)}
          </text>
        </g>
      );
    })}

    {data.map((d, i) => {
      const x = pad.l + i * (bw + gap);
      const hitH = (d.hits / maxV) * ih;
      const botH = (d.bots / maxV) * ih;
      const hitY = pad.t + ih - hitH;
      const botY = pad.t + ih - botH;

      return (
        <g class="bar-group" style="cursor:pointer;">
          <rect class="bar-hover" x={x - gap/2} y={pad.t} width={bw + gap} height={ih} fill="var(--text)" opacity="0" />
          <rect x={x} y={hitY} width={bw} height={hitH} fill="var(--hit)" rx="2" />
          {d.bots > 0 && <rect x={x} y={botY} width={bw} height={botH} fill="var(--bot)" rx="2" />}
          {i % 4 === 0 && (
            <text x={x + bw / 2} y={h - 6} text-anchor="middle" fill="var(--text-3)" font-size="10" font-family="var(--mono)">
              {String(i).padStart(2, '0')}h
            </text>
          )}
        </g>
      );
    })}
  </svg>

  <div class="bar-tooltip" style="display:none;position:absolute;top:10px;pointer-events:none;background:rgba(22, 24, 28, 0.92);backdrop-filter:blur(8px);border:1px solid var(--border);border-radius:var(--radius-sm);padding:8px 12px;box-shadow:var(--shadow);z-index:20;font-size:12px;color:#ffffff;min-width:130px;">
    <div class="tt-hour" style="font-weight:600;margin-bottom:4px;font-family:var(--mono);"></div>
    <div style="display:flex;justify-content:space-between;gap:12px;"><span>Hits:</span><span class="tt-hits" style="font-family:var(--mono);"></span></div>
    <div style="display:flex;justify-content:space-between;gap:12px;color:var(--bot);"><span>Bots:</span><span class="tt-bots" style="font-family:var(--mono);"></span></div>
    <div style="display:flex;justify-content:space-between;gap:12px;font-size:11px;color:var(--text-3);"><span>Bot Ratio:</span><span class="tt-botpct" style="font-family:var(--mono);"></span></div>
  </div>
</div>

<script is:inline define:vars={{ id, chartDataJson }}>
  (function() {
    const wrap = document.getElementById(id);
    if (!wrap) return;
    const tooltip = wrap.querySelector('.bar-tooltip');
    const barGroups = wrap.querySelectorAll('.bar-group');
    const data = JSON.parse(chartDataJson);

    barGroups.forEach((group, i) => {
      group.addEventListener('mouseenter', () => {
        const hover = group.querySelector('.bar-hover');
        if (hover) hover.style.opacity = '0.08';
        const d = data[i];
        if (!d) return;

        tooltip.style.display = 'block';
        tooltip.style.left = i > 16 ? `${(i / data.length) * 100 - 25}%` : `${(i / data.length) * 100 + 4}%`;
        tooltip.querySelector('.tt-hour').textContent = `Hour ${d.hour}`;
        tooltip.querySelector('.tt-hits').textContent = d.hits.toLocaleString();
        tooltip.querySelector('.tt-bots').textContent = d.bots.toLocaleString();
        tooltip.querySelector('.tt-botpct').textContent = `${d.botPct}%`;
      });

      group.addEventListener('mouseleave', () => {
        const hover = group.querySelector('.bar-hover');
        if (hover) hover.style.opacity = '0';
        tooltip.style.display = 'none';
      });
    });
  })();
</script>

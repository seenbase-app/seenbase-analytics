---
interface Props {
  active: string;
}
const { active } = Astro.props;
---
<aside class="sidebar">
  <a class="brand" href="/dashboard">
    <div class="brand-mark">SB</div>
    <div class="brand-name">SeenBase <span>Analytics</span></div>
  </a>

  <div class="navsec">Workspace</div>
  <a href="/dashboard" class={`navitem ${active === 'pixels' ? 'active' : ''}`}>
    <span class="glyph">❖</span>
    <span>Pixels</span>
  </a>

  <div style="flex:1"></div>

  <button
    id="theme-toggle"
    class="btn ghost"
    style="justify-content:flex-start;padding:8px 10px;margin-top:auto;"
    type="button"
  >
    <span style="font-size:14px;">◑</span>
    <span>Toggle theme</span>
  </button>

  <a href="/logout" class="navitem" style="color:var(--text-3);">
    <span>↪</span>
    <span>Sign out</span>
  </a>

  <div style="padding:10px 10px 4px;font-size:11px;line-height:1.4;color:var(--text-3);border-top:1px solid var(--border-subtle);margin-top:8px;">
    We respect the open web.<br />
    <a href="https://github.com/seenbase-app/seenbase-analytics" target="_blank" rel="noopener noreferrer" style="color:var(--text-2);text-decoration:underline;">Source on GitHub ↗</a>
  </div>
</aside>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    if (isDark) {
      document.documentElement.removeAttribute('data-theme');
      localStorage.setItem('theme', 'light');
    } else {
      document.documentElement.setAttribute('data-theme', 'dark');
      localStorage.setItem('theme', 'dark');
    }
  });
</script>

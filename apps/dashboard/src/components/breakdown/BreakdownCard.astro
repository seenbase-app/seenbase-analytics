---
import { getCountryFlag, getCategoryIconSvg } from '../../lib/icons';

interface Row {
  label: string;
  val: number;
  pct: number;
  code?: string;
  asn?: string;
}

interface Props {
  title: string;
  rows: Row[];
  showCode?: boolean;
  showAsn?: boolean;
}

const { title, rows, showCode = false, showAsn = false } = Astro.props;

function fmt(n: number): string {
  if (n >= 1_000_000) return (n/1_000_000).toFixed(1).replace(/\.0$/, '') + 'M';
  if (n >= 10_000) return Math.round(n/1000) + 'K';
  if (n >= 1000) return (n/1000).toFixed(1).replace(/\.0$/, '') + 'K';
  return String(n);
}

function fmtPct(n: number): string {
  return (n >= 10 ? n.toFixed(0) : n.toFixed(1)) + '%';
}
---
<div class="bd-card card" style="display:flex;flex-direction:column;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);box-shadow:var(--shadow-sm);overflow:hidden;">
  <div class="cardhead" style="display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:1px solid var(--border-2);background:var(--surface-3);">
    <h3 style="margin:0;font-size:13.5px;font-weight:600;color:var(--text);">{title}</h3>
  </div>

  <div class="bd-list" style="display:flex;flex-direction:column;padding:6px 12px;">
    {rows.length === 0 ? (
      <div style="padding:16px 8px;font-size:12px;color:var(--text-3);text-align:center;">
        No data available for this breakdown.
      </div>
    ) : (
      rows.map(r => (
        <div class="bd-row" style="display:grid;grid-template-columns:1fr 60px 48px;align-items:center;padding:8px 6px;border-bottom:1px solid var(--border-2);position:relative;">
          <div class="bar-bg" style={`position:absolute;top:4px;bottom:4px;left:0;width:${Math.min(100, Math.max(2, r.pct))}%;background:var(--surface-3);border-radius:4px;z-index:0;`} />
          <div class="label" style="position:relative;z-index:1;display:flex;align-items:center;gap:8px;min-width:0;font-size:12.5px;">
            {showCode ? (
              <span class="flag" style="font-size:13px;line-height:1;">{getCountryFlag(r.code || r.label)}</span>
            ) : (
              <span class="icon" style="display:inline-flex;align-items:center;color:var(--text-3);" set:html={getCategoryIconSvg(r.label)} />
            )}
            <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--text);font-weight:500;">
              {r.label}
            </span>
            {showAsn && r.asn && (
              <span style="font-size:11px;color:var(--text-3);font-family:var(--mono);">({r.asn})</span>
            )}
          </div>
          <div class="v" style="position:relative;z-index:1;text-align:right;font-family:var(--mono);font-size:12px;color:var(--text);">
            {fmt(r.val)}
          </div>
          <div class="p" style="position:relative;z-index:1;text-align:right;font-family:var(--mono);color:var(--text-3);font-size:11.5px;">
            {fmtPct(r.pct)}
          </div>
        </div>
      ))
    )}
  </div>
</div>
